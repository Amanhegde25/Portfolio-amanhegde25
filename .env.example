# Copy this file to .env.local and fill in your values
# .env.local is gitignored and never committed.

# Gmail SMTP settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# The Gmail address that sends the contact form emails
SMTP_USER=your-email@gmail.com

# Gmail App Password (generate at https://myaccount.google.com/apppasswords)
# Requires 2-Step Verification on the Google account.
SMTP_PASS=your-16-char-app-password

# Email that receives contact form submissions (usually the same as SMTP_USER)
CONTACT_TO=your-email@gmail.com